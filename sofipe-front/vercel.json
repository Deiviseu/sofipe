{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/sofipe-front/browser",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://sofipe.arbru.com.br/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
